# =========================
# Environment Setup
# =========================
# 1. In your project, go to the `nft_mint_server` folder.
# 2. Create a new file in this folder and name it exactly: `.env`
#    (right-click → New File → type `.env`).
# 3. Open `.env.template` (this file) and copy all its contents.
# 4. Paste the contents into your new `.env` file.

# =========================
# Pinata Credentials
# =========================
# 5. Go to https://app.pinata.cloud/developers/api-keys
# 6. Click "New Key", toggle to **Admin**, and click "Create".
# 7. Copy the API Key and API Secret and paste them into your `.env` below.
#    (Alternatively you can create a JWT and set PINATA_JWT instead of key/secret.)

PINATA_API_KEY=YOUR_PINATA_API_KEY_GOES_HERE
PINATA_API_SECRET=YOUR_PINATA_API_SECRET_GOES_HERE
PINATA_JWT=

# =========================
# Stripe Test Credentials
# =========================
# Obtain from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_value_here
# Populate after running `stripe listen --forward-to ...` or from Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_value_here

# =========================
# Server Config
# =========================
PORT=3001
FRONTEND_BASE_URL=http://localhost:5173
# Override these if you want explicit redirect URLs instead of the defaults derived above.
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
